---
import Layout from "@/src/layouts/Layout.astro";
import { loadShareMetadata } from "@/app/lib/shareMetadata";

export const prerender = false;

const id = Astro.params.id ?? "";
const baseUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://phantomdrum.com";

function deslugify(slug: string): string {
  return slug
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

const metadata = await loadShareMetadata(id).catch(() => null);
if (!metadata) {
  Astro.response.status = 404;
}

const sentence = metadata?.sentence || deslugify(id) || "Sentence Cube";
const shareUrl = `${baseUrl}/share/${id}`;
const redirectUrl = `/?share=${id}`;
---

<Layout
  title={sentence}
  description={sentence}
  image={metadata?.imageUrl ?? "/img/og-image.jpg"}
>
  <meta slot="head" property="og:url" content={shareUrl} />
  <meta slot="head" property="og:type" content="website" />
  <div class="min-h-screen bg-black text-white flex flex-col items-center justify-center p-6">
    <div class="mx-auto w-full max-w-3xl text-center space-y-4">
      <p class="text-4xl font-bold text-white">Redirecting to the sentence cube</p>
      <p class="text-lg text-white/80">
        Hang tight while we bring you back to the interactive experience.
      </p>
      <h1 class="text-sm uppercase tracking-[0.5em] text-white/60">
        {sentence}
      </h1>
      <a
        href={redirectUrl}
        class="inline-block px-4 py-2 uppercase tracking-[0.4em] text-sm border border-white/40 rounded"
      >
        Continue to homepage
      </a>
    </div>
    <script is:inline define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
  </div>
</Layout>
