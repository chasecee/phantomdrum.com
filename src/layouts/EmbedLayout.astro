---
import "@/app/embed.css";

interface Props {
  title?: string;
  scrollable?: boolean;
  includeGlobals?: boolean;
  embedDpr?: number | null;
}

const {
  title = "phantom drum",
  scrollable = false,
  includeGlobals = false,
  embedDpr = null,
} = Astro.props;

if (includeGlobals) {
  await import("@/app/globals.css");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {scrollable ? (
      <style>
        html,
        body {
          margin: 0;
          width: 100%;
          background: #000;
        }
      </style>
    ) : (
      <style>
        html,
        body {
          margin: 0;
          height: 100%;
          width: 100%;
          overflow: hidden;
          background: #000;
        }

        astro-island {
          display: block;
          height: 100%;
          width: 100%;
        }
      </style>
    )}
  </head>
  <body data-embed-dpr={embedDpr ?? undefined}>
    <slot />
  </body>
</html>
